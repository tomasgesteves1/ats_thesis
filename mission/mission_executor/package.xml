<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_executor</name>
  <version>0.0.0</version>
  <description>Runs missions written as sequences of UAV and USV maneuvers and publishes the controllers' references</description>
  <maintainer email="tomas@todo.todo">tomas</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>mission_maneuvers</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
