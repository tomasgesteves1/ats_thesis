<?xml version="1.0" ?>
<sdf version="1.9">
    <model name="anchor">
        <link name="anchor_link">
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>0.0001</ixx>
                    <iyy>0.0001</iyy>
                    <izz>0.0001</izz>
                </inertia>
            </inertial>
            <!-- Visual removido para estética -->
        </link>
        
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>anchor_link</parent_link>
            <child_model>wamv</child_model>
            <child_link>wamv/tether_anchor</child_link>
            <topic>/anchor/to_boat</topic>
        </plugin>

        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>anchor_link</parent_link>
            <child_model>tether</child_model>
            <child_link>link_base</child_link>
            <topic>/anchor/to_tether</topic>
        </plugin>
    </model>
</sdf>
