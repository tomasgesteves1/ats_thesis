            </inertial>
            <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
            <visual name="visual">
                <geometry><cylinder><radius>0.01</radius><length>0.147</length></cylinder></geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.1 0.1 0.1 1</diffuse>
                </material>
            </visual>
        </link>
