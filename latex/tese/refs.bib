  shorttitle = {Deep Networks for System Identification},
  author = {Pillonetto, Gianluigi and Aravkin, Aleksandr and Gedon, Daniel and Ljung, Lennart and Ribeiro, Ant{\^o}nio H. and Sch{\"o}n, Thomas B.},
  year = 2025,
