@article{intro_usv_uavs,
  title = {Unmanned {{Surface Vessel}}--{{Unmanned Aerial Vehicle Cooperative Path Following Based}} on a {{Predictive Line}} of {{Sight Guidance Law}}},
  author = {Zhang, Hugan and Fan, Jiaming and Zhang, Xianku and Xu, Haitong and Guedes Soares, C.},
