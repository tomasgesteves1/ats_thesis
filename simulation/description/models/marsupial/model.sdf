<?xml version="1.0" ?>
<sdf version="1.9">
    <model name="marsupial">
        <!-- Desativado self_collide por agora para estabilizar a vara -->
        <self_collide>false</self_collide>
        <pose>0 0 0.2 0 0 0</pose>

        <include merge='true'>
            <uri>model://wamv</uri>
            <pose>0 0 0.2 0 0 0</pose>
        </include>

        <include merge='true'>
            <uri>model://x500</uri>
            <pose>0.3 0 1.65 0 0 0</pose>
        </include>

        <!-- Ponto Verde -->
        <link name="tether_anchor">
            <pose>-0.5 0 1.5 0 0 0</pose>
            <inertial><mass>0.01</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
            <visual name="visual">
                <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
                <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
            </visual>
        </link>

        <!-- Ponto Vermelho (Agora coincide exatamente com o drone_pose) -->
        <link name="drone_attachment_point">
            <pose>0.3 0 1.65 0 0 0</pose> 
            <inertial><mass>0.01</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
            <visual name="visual">
                <geometry><sphere><radius>0.05</radius></sphere></geometry>
                <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
            </visual>
        </link>

        <!-- Vara de Ligação -->
        <link name="link_0">
            <pose>-0.1 0.0 1.575 0 1.385448376799202 0.0</pose>
            <inertial>
                <mass>0.02</mass>
                <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>1e-4</izz></inertia>
            </inertial>
            <visual name="visual">
                <geometry><cylinder><radius>0.005</radius><length>0.8139410298049854</length></cylinder></geometry>
                <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
            </visual>
            <!-- COLISÃO DESATIVADA PARA NÃO EMPURRAR O DRONE -->
        </link>

        <joint name="anchor_to_boat" type="fixed">
            <parent>wamv/base_link</parent>
            <child>tether_anchor</child>
        </joint>

        <joint name="joint_start" type="universal">
            <parent>tether_anchor</parent>
            <child>link_0</child>
            <pose>0 0 -0.4069705149024927 0 0 0</pose>
            <axis><xyz>1 0 0</xyz></axis><axis2><xyz>0 1 0</xyz></axis2>
        </joint>

        <joint name="joint_end" type="universal">
            <parent>link_0</parent>
            <child>drone_attachment_point</child>
            <pose>0 0 0 0 0 0</pose> 
            <axis><xyz>1 0 0</xyz></axis><axis2><xyz>0 1 0</xyz></axis2>
        </joint>

        <joint name="attachment_to_drone" type="fixed">
            <parent>drone_attachment_point</parent>
            <child>base_link</child>
        </joint>
        
    </model>
</sdf>
